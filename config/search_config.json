    "reason": "Known relationship or referral path. These companies receive additional monitoring but no job-fit score advantage."
  },

  "market_intelligence": {
    "companies": [
      "Amazon"
    ],
    "surface_as_application_opportunity": false,
    "use_for": [
      "Emerging job titles",
      "Skill trends",
      "Role design",
      "Compensation signals"
    ]
  },

  "early_rejection_terms": [
    "Entry Level",
    "Coordinator",
    "Event Manager",
    "Event Producer",
    "Account Executive",
    "Sales Representative",
    "Recruiter",
    "Machine Learning Engineer",
    "Data Scientist"
  ],

  "work_model_handling": {
    "fully_remote": "Prioritize",
    "remote_with_occasional_travel": "Prioritize",
    "hybrid": "Discover and Flag",
    "onsite": "Discover and Flag",
    "recurring_office_attendance": "Discover and Flag",
    "unclear": "Needs Information"
  },

  "ambiguous_conditions": {
    "remote_status_unclear": "Needs Information",
    "compensation_missing": "Continue Evaluation",
    "seniority_unclear": "Continue Evaluation",
    "unfamiliar_job_title": "Analyze Responsibilities"
  },

  "discovery_policy": {
    "title_match_required": false,
    "concept_match_allowed": true,
    "discover_unexpected_titles": true,
    "relationship_required": false,
    "known_company_required": false,
    "work_model_should_not_prevent_discovery": true,
    "rule": "Search broadly and evaluate roles based on responsibilities, scope, career direction, demonstrated experience, and overall opportunity quality rather than relying on exact job titles or prematurely excluding roles because of work arrangement."
  }
