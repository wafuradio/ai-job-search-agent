    "remote_preferred": true,
    "remote_only": false,
    "include_hybrid": true,
    "include_onsite": true,
    "search_broadly_across_companies": true,
    "rule": "Prioritize remote opportunities during discovery, but do not exclude hybrid or onsite roles before evaluation."
  },

  "role_searches": [
