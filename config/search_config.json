    "AI Workflow",
    "Strategic Programs",
    "Staff Program Manager",
    "Principal Program Manager",
    "Director AI Programs",
    "Director Business Operations",
    "Director Operational Transformation",
    "Chief of Staff"
  ],

  "concept_searches": [
    "AI adoption",
    "enterprise AI transformation",
    "AI operating model",
    "AI implementation",
    "AI workflow transformation",
    "AI-enabled operations",
    "business process transformation",
    "workflow automation",
    "intelligent automation",
    "agentic workflow",
    "AI agents",
    "operational excellence",
    "operating model transformation",
    "business systems",
    "process redesign"
  ],

  "preferred_seniority_terms": [
    "Staff",
    "Principal",
    "Lead",
    "Director",
    "Senior"
